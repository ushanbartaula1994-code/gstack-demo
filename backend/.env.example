# Database Configuration
# Local PostgreSQL
DATABASE_URL=postgresql://aifitness:aifitness2024@localhost:5432/aifitnesscoach

# OR Neon (cloud PostgreSQL)
# DATABASE_URL=postgresql://aifitness:YOUR_PASSWORD@YOUR_NEON_HOST:5432/aifitnesscoach?sslmode=require

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# Supabase Auth (optional - if using Supabase Auth)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# API Configuration
API_PORT=8000
API_HOST=localhost

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Claude API (for LLM)
CLAUDE_API_KEY=your-claude-api-key

